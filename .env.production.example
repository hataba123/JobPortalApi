MSSQL_SA_PASSWORD=replace-with-a-strong-production-password
APP_DB_CONNECTION=Server=sqlserver,1433;Database=JobPortal;User Id=jobportal_app;Password=replace-with-app-password;TrustServerCertificate=False;Encrypt=True;MultipleActiveResultSets=True
REDIS_PASSWORD=replace-with-a-random-redis-password
APP_ORIGIN=https://hirehub.io.vn
EMAIL_WEBHOOK_URL=https://internal-mail.example/api/send
EMAIL_WEBHOOK_SECRET=replace-with-email-webhook-secret
TLS_CERTIFICATE_PATH=/etc/letsencrypt/live/hirehub.io.vn/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/hirehub.io.vn/privkey.pem
JWT_KEY=replace-with-a-random-production-secret-at-least-32-characters
JWT_ISSUER=JobPortal
JWT_AUDIENCE=JobPortalClient
NEXTAUTH_URL=https://hirehub.io.vn
NEXTAUTH_SECRET=replace-with-a-random-production-nextauth-secret
OAUTH_EXCHANGE_SECRET=replace-with-the-same-secret-used-by-the-frontend
VNPAY_TMN_CODE=replace-with-vnpay-production-tmn-code
VNPAY_HASH_SECRET=replace-with-vnpay-production-hash-secret
VNPAY_PAYMENT_URL=https://pay.vnpay.vn/vpcpay.html
VNPAY_RETURN_URL=https://hirehub.io.vn/vi/payment/return
GOOGLE_CLIENT_ID=replace-with-google-production-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-production-client-secret
GITHUB_CLIENT_ID=replace-with-github-production-client-id
GITHUB_CLIENT_SECRET=replace-with-github-production-client-secret
